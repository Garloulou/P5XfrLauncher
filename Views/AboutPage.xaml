<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LauncherP5XFr.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LauncherP5XFr.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,12,24,24" RowSpacing="16" MaxWidth="950" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status InfoBar & Progress -->
            <StackPanel Grid.Row="0" Spacing="6">
                <InfoBar x:Name="AboutInfoBar" IsOpen="False" IsClosable="True" />
                <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" IsIndeterminate="False" Value="0" Maximum="100" />
            </StackPanel>

            <!-- Header Card with Icon, Artwork and Version -->
            <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon / Artwork -->
                    <Border x:Name="AboutCapsuleBorder" Grid.Column="0" CornerRadius="12" Width="84" Height="84"
                            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center">
                        <Grid Background="#1A1A1E">
                            <FontIcon x:Name="AboutFallbackIcon" Glyph="&#xE7FC;" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="AboutCapsuleImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <Image x:Name="AboutLogoImage" Height="38" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />

                        <StackPanel x:Name="AboutFallbackTitlePanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource P5CrimsonBrush}" Width="36" Height="36" CornerRadius="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7FC;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Persona 5: The Phantom X" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Launcher &amp; Auto-Updater Français (PC Steam)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="{StaticResource P5CrimsonBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="LauncherVersionTextBlock" Text="v1.0.3" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="WinUI 3 / Windows App SDK" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Button x:Name="CheckUpdateButton" Content="Vérifier les mises à jour" Click="CheckUpdateButton_Click" Padding="10,3" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credits & Community Card -->
            <Border Grid.Row="2" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Crédits &amp; Remerciements" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Ce launcher a été spécialement conçu pour la communauté française de Persona 5: The Phantom X. Il permet de gérer de manière transparente et réversible l'injection BepInEx et les mises à jour de traduction publiées sur GitHub."
                               FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <MenuFlyoutSeparator Margin="0,4" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Équipe de Traduction FR" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Traduction, relecture, localisation des textures et intégration des scripts." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Projet BepInEx &amp; Doorstop" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Framework d'injection et de modding pour les jeux Unity PC." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <HyperlinkButton Content="Dépôt GitHub du Launcher" NavigateUri="https://github.com/Garloulou/P5XfrLauncher" />
                        <HyperlinkButton Content="Dépôt GitHub de la Traduction" NavigateUri="https://github.com/Gyotre/P5X-Traduction-FR" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Legal Disclaimer Card -->
            <Border Grid.Row="3" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mentions Légales" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Persona 5: The Phantom X (P5X), les personnages, logos et univers sont des marques déposées d'ATLUS, SEGA et Perfect World Co., Ltd. Ce launcher est un projet amateur indépendant à but non lucratif, non affilié et non sponsorisé par les détenteurs de droits."
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Technical Environment Details -->
            <Border Grid.Row="4" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Informations Système" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="SysInfoTextBlock" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
