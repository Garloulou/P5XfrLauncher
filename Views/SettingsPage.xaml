<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LauncherP5XFr.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LauncherP5XFr.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,12,24,24" RowSpacing="16" MaxWidth="950" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status InfoBar -->
            <InfoBar x:Name="SettingsInfoBar" Grid.Row="0" IsOpen="False" IsClosable="True" />

            <!-- Title Header -->
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="Paramètres" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Configuration de l'emplacement du jeu et des préférences du launcher."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            </StackPanel>

            <!-- Section 1: Game Directory -->
            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="Emplacement de Persona 5: The Phantom X" FontSize="16" FontWeight="SemiBold" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Dossier d'installation du jeu" FontWeight="SemiBold" />
                                <TextBlock Text="Dossier contenant l'exécutable du jeu (ex: P5X.exe ou Persona 5 The Phantom X.exe)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Content="Parcourir..." HorizontalAlignment="Right" Click="BrowseFolder_Click" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GamePathTextBox" PlaceholderText="C:\Program Files (x86)\Steam\steamapps\common\Persona 5 The Phantom X" TextChanged="GamePathTextBox_TextChanged" />
                            <TextBox x:Name="GameExeTextBox" Grid.Column="1" Header="Exécutable" PlaceholderText="P5X.exe" TextChanged="GameExeTextBox_TextChanged" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                            <Button Click="AutoDetectFolders_Click" Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" />
                                    <TextBlock Text="Détecter automatiquement via Steam" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Lancement via Steam (steam://rungameid/)" FontWeight="SemiBold" />
                                <TextBlock Text="Active l'overlay Steam, les succès et le suivi du temps de jeu (AppID : 3061570)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ToggleSwitch x:Name="LaunchViaSteamToggleSwitch" Grid.Column="1" Toggled="LaunchViaSteamToggleSwitch_Toggled" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Section 2: BepInEx Toggle Behavior -->
            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Text="Bascule BepInEx / Doorstop" FontSize="16" FontWeight="SemiBold" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="3">
                            <TextBlock Text="Méthode de désactivation de la traduction" FontWeight="SemiBold" />
                            <TextBlock Text="Méthode employée pour couper le chargement de la traduction française" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <RadioButtons x:Name="ToggleMethodRadioButtons" Grid.Row="1" SelectionChanged="ToggleMethodRadioButtons_SelectionChanged">
                            <RadioButton x:Name="RadioRenameDll" Content="Renommer winhttp.dll en winhttp.dll.disabled (Méthode principale recommandée, 100% réversible)" />
                            <RadioButton x:Name="RadioDoorstopConfig" Content="Modifier enabled = false dans doorstop_config.ini" />
                        </RadioButtons>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Section 3: Appearance & Language -->
            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock Text="Apparence &amp; Langue" FontSize="16" FontWeight="SemiBold" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ThemeComboBox" Header="Thème de l'application" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Par défaut (Système)" Tag="Default" />
                            <ComboBoxItem Content="Sombre (Dark)" Tag="Dark" />
                            <ComboBoxItem Content="Clair (Light)" Tag="Light" />
                        </ComboBox>

                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Header="Langue de l'interface" SelectionChanged="LanguageComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Français" Tag="fr-FR" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Section 4: Maintenance & Logs -->
            <StackPanel Grid.Row="5" Spacing="8">
                <TextBlock Text="Maintenance &amp; Diagnostic" FontSize="16" FontWeight="SemiBold" />

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Installer / Réinstaller BepInEx" Click="ReinstallBepInEx_Click" />
                        <Button Content="Ouvrir le fichier de log" Click="OpenLogFile_Click" />
                        <Button Content="Ouvrir le dossier du jeu" Click="OpenGameFolder_Click" />
                        <Button Content="Ouvrir le dossier Images (Assets)" Click="OpenAssetsFolder_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
