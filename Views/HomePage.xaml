<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LauncherP5XFr.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LauncherP5XFr.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,12,24,24" RowSpacing="16" MaxWidth="1050" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Notification & Alert InfoBar & Progress -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,4">
                <InfoBar
                    x:Name="MainInfoBar"
                    IsOpen="False"
                    IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="InfoBarInstallBepInExButton" Content="Installer BepInEx" Click="InfoBarInstallBepInExButton_Click" Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <ProgressBar x:Name="DownloadProgressBar" Visibility="Collapsed" IsIndeterminate="False" Value="0" Maximum="100" />
            </StackPanel>

            <!-- Hero Banner with Persona 5 Aesthetic -->
            <Border
                Grid.Row="1"
                CornerRadius="12"
                Height="210"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F0F12" Offset="0.0" />
                        <GradientStop Color="#2B0E14" Offset="0.55" />
                        <GradientStop Color="#8B0012" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Image
                        x:Name="HeroBackgroundImage"
                        Stretch="UniformToFill"
                        Opacity="0.35"
                        HorizontalAlignment="Right" />

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#F00D0D10" Offset="0.0" />
                                <GradientStop Color="#CC121216" Offset="0.5" />
                                <GradientStop Color="#33000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Center" Margin="32,0,0,0" Spacing="6" MaxWidth="580" HorizontalAlignment="Left">
                        <Border Background="{StaticResource P5CrimsonBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="LAUNCHER OFFICIEL COMMUNAUTAIRE" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <TextBlock Text="PERSONA 5" FontSize="36" FontWeight="Black" FontFamily="Segoe UI Variable" Foreground="White" CharacterSpacing="50" />
                        <TextBlock Text="THE PHANTOM X" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource P5GoldBrush}" CharacterSpacing="80" Margin="0,-4,0,0" />
                        <TextBlock Text="Lancez Persona 5: The Phantom X avec ou sans la traduction française BepInEx en un simple clic."
                                   FontSize="13" Foreground="#D0D0D8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Control Section: Toggle & Play Button -->
            <Border Grid.Row="2" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top status bar inside the card -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Statut BepInEx :" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                            <Border x:Name="StatusBadgeBorder" Background="{StaticResource P5CardBackgroundBrush}" CornerRadius="12" Padding="10,4" BorderThickness="1" BorderBrush="{StaticResource P5CardBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon x:Name="StatusBadgeIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource P5CrimsonBrush}" />
                                    <TextBlock x:Name="StatusBadgeText" Text="Initialisation..." FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,8,0,0" />

                    <!-- Action Row: Toggle Switch & Big JOUER Button -->
                    <Grid Grid.Row="1" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Toggle Switch -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16,14" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Traduction française (BepInEx)" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Active le proxy Doorstop (winhttp.dll) pour charger la traduction FR"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="TranslationToggleSwitch"
                                    Grid.Column="1"
                                    OnContent="Activée"
                                    OffContent="Désactivée"
                                    Toggled="TranslationToggleSwitch_Toggled"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Big JOUER Button -->
                        <Button
                            x:Name="PlayButton"
                            Grid.Column="1"
                            Style="{StaticResource PlayButtonStyle}"
                            Click="PlayButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="24" />
                                <TextBlock Text="JOUER" FontSize="20" FontWeight="Bold" CharacterSpacing="60" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom Information Cards -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Game Directory -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{StaticResource P5CrimsonBrush}" />
                            <TextBlock Text="Emplacement du jeu" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>

                        <TextBlock
                            x:Name="GamePathTextBlock"
                            Grid.Row="1"
                            Text="Recherche de l'installation..."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="Ouvrir le dossier" Click="OpenGameFolder_Click" Padding="10,4" />
                            <Button Content="Changer..." Click="ChangeGameFolder_Click" Padding="10,4" />
                            <Button Content="Détection Steam" Click="AutoDetectGame_Click" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: BepInEx Status Details -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource P5GoldBrush}" />
                            <TextBlock Text="Framework BepInEx &amp; Traduction" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TranslationDetailsTextBlock"
                            Grid.Row="1"
                            Text="Analyse du dossier..."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="InstallBepInExButton" Content="Installer BepInEx" Click="InstallBepInEx_Click" Visibility="Collapsed" Padding="10,4" />
                            <Button x:Name="CheckTranslationUpdateButton" Content="Mettre à jour la traduction" Click="CheckTranslationUpdate_Click" Padding="10,4" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="3"
                            Text="Méthode : renommage sécurisé réversible de winhttp.dll"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Margin="0,4,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
