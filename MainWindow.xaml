<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LauncherP5XFr.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LauncherP5XFr"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Persona 5: The Phantom X - Launcher FR"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ambient Wallpaper Background behind everything -->
        <Image
            x:Name="WindowBackgroundImage"
            Grid.RowSpan="2"
            Stretch="UniformToFill"
            Opacity="0.08"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False" />

        <!-- Custom Fluent Windows 11 TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <Image x:Name="TitleBarLogoImage" Height="22" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed" />
                <Border x:Name="TitleBarIconBorder" Background="{StaticResource P5CrimsonBrush}" Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="PERSONA 5: THE PHANTOM X" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border Background="{StaticResource P5CrimsonBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="FR LAUNCHER" FontSize="10" FontWeight="Bold" Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Drag Area fills remaining center space -->
            <Grid Grid.Column="1" Background="Transparent" />
        </Grid>

        <!-- Modern Fluent NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Tag="Home" Content="Accueil">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Tag="Settings" Content="Paramètres">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAbout" Tag="About" Content="À propos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <!-- Host for Views with smooth slide transition -->
                <Frame x:Name="ContentFrame">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
